{
  "name": "korei-site",
  "version": "1.0.0",
  "private": true,
  "description": "Korei — parfumerie de niche (front statique + fonctions serverless)",
  "scripts": {
    "dev": "node dev-server.js",
    "check": "node scripts/check.js",
    "lint": "npm run check",
    "test": "node --test",
    "build": "npm run check && npm test && node scripts/build-static.js",
    "shopify:discounts": "node scripts/configure-shopify-discounts.js",
    "shopify:discounts:apply": "node scripts/configure-shopify-discounts.js --apply",
    "shopify:discounts:nettoyer": "node scripts/configure-shopify-discounts.js --nettoyer",
    "shopify:inventory": "node scripts/configure-shopify-inventory.js",
    "shopify:inventory:apply": "node scripts/configure-shopify-inventory.js --apply"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0"
  }
}
