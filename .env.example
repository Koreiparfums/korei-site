GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX_REQUESTS=12
# Monitoring coûts chatbot — estimations, toutes optionnelles (valeurs par défaut ci-dessous)
CHAT_BUDGET_USD_MONTHLY=20
GROQ_PRICE_INPUT_PER_1M=0.59
GROQ_PRICE_OUTPUT_PER_1M=0.79
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=your_storefront_public_token_here
ADMIN_TOKEN=change_me_to_a_strong_password
